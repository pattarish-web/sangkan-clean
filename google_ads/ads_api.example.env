# Copy to the repo root as .env — never commit the filled file.
#   cp google_ads/ads_api.example.env .env
#
# Use a Google Cloud project (enable Google Ads API + Explorer access).
# Do not create a second MCC developer token from Ads API Center.
#
# OAuth: download the Desktop client JSON to google_ads/client_secret.json
# then:
#   python google_ads/auth.py
# which writes GOOGLE_ADS_REFRESH_TOKEN into .env

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Optional leftover. Sunset 2026-09-09 — Ads ignores it. Leave empty.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional overrides (defaults match Sangkan Clean + MCC)
GOOGLE_ADS_TARGET_CUSTOMER_ID=6151208199
GOOGLE_ADS_LOGIN_CUSTOMER_ID=7915729299

# After setup_offline_conversions.py --apply, confirmed leads upload via:
#   python google_ads/upload_offline_conversions.py --apply
# or immediately from the webhook when these same keys are in ops/webhook/.env
